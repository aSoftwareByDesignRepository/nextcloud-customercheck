{
    "name": "customercheck",
    "private": true,
    "version": "1.6.184",
    "type": "module",
    "description": "CustomerCheck Playwright / frontend tooling",
    "scripts": {
        "test:e2e": "playwright test",
        "test:js": "vitest run && node tests/js/app-feedback.test.cjs",
        "test:unit:php": "php vendor/bin/phpunit --testsuite unit",
        "test:integration:php": "php vendor/bin/phpunit --testsuite integration",
        "test:mutation": "php tests/Mutation/run-critical-service-mutations.php && php tests/Mutation/run-single-org-mutations.php",
        "test:mutation:single-org": "php tests/Mutation/run-single-org-mutations.php",
        "check:l10n": "php scripts/check-l10n-parity.php && php scripts/check-l10n-placeholders.php && php scripts/check-l10n-de-quality.php && php scripts/check-l10n-native-quality.php && php scripts/sync-l10n-variants.php --check",
        "l10n:js": "php scripts/rebuild-l10n-js.php",
        "l10n:variants": "php scripts/sync-l10n-variants.php && php scripts/rebuild-l10n-js.php",
        "test:mutation:l10n-de": "php tests/Mutation/run-l10n-de-quality-mutations.php",
        "test:mutation:bachus": "php tests/Mutation/run-bachus-simplicity-mutations.php",
        "test:mutation:zeus-bachus-shouldfix": "php tests/Mutation/run-zeus-bachus-shouldfix-mutations.php",
        "test:mutation:signature-logo": "php tests/Mutation/run-signature-logo-mutations.php",
        "test:mutation:talk-answer-send": "php tests/Mutation/run-talk-answer-send-mutations.php",
        "test:mutation:mail-attach-picker": "php tests/Mutation/run-mail-attach-picker-mutations.php",
        "test:mutation:outbound-assign": "php tests/Mutation/run-outbound-assign-mutations.php",
        "test:mutation:deal-checklist": "php tests/Mutation/run-deal-checklist-mutations.php",
        "test:mutation:person-dialog": "php tests/Mutation/run-person-dialog-mutations.php",
        "test:mutation:company360-focus": "php tests/Mutation/run-company360-focus-mutations.php",
        "test:mutation:prepare-meeting-removed": "php tests/Mutation/run-prepare-meeting-removed-mutations.php",
        "test:mutation:filter-live": "php tests/Mutation/run-filter-live-mutations.php",
        "test:mutation:datepicker": "php tests/Mutation/run-datepicker-mutations.php",
        "test:mutation:new-deal-form": "php tests/Mutation/run-new-deal-form-mutations.php",
        "test:mutation:theme-adaptability": "php tests/Mutation/run-theme-adaptability-mutations.php",
        "test:mutation:account-plan": "php tests/Mutation/run-account-plan-layout-mutations.php && php tests/Mutation/run-account-plan-save-mutations.php",
        "test:mutation:platform-links": "php tests/Mutation/run-platform-links-mutations.php",
        "test:mutation:app-feedback": "php tests/Mutation/run-app-feedback-links-mutations.php",
        "test:mutation:mobile-links": "php tests/Mutation/run-mobile-app-links-mutations.php",
        "test:mutation:list-toolbar": "php tests/Mutation/run-list-toolbar-mutations.php",
        "test:mutation:strategy-board": "php tests/Mutation/run-strategy-board-mutations.php",
        "test:mutation:gdpr-erase-in-clause": "php tests/Mutation/run-gdpr-erase-in-clause-mutations.php"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.10.1",
        "@playwright/test": "^1.51.0",
        "vitest": "^3.0.0"
    }
}
